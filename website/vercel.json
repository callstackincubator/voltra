{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml"
    }
  ],
  "redirects": [
    {
      "source": "/v1/:path*",
      "destination": "/:path*",
      "statusCode": 301
    },
    {
      "source": "/v1",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/getting-started",
      "destination": "/getting-started/introduction",
      "statusCode": 301
    },
    {
      "source": "/ios",
      "destination": "/ios/introduction",
      "statusCode": 301
    },
    {
      "source": "/android",
      "destination": "/android/introduction",
      "statusCode": 301
    },
    {
      "source": "/development",
      "destination": "/ios/development/developing-live-activities",
      "statusCode": 301
    },
    {
      "source": "/components",
      "destination": "/ios/components/overview",
      "statusCode": 301
    },
    {
      "source": "/api",
      "destination": "/ios/api/configuration",
      "statusCode": 301
    }
  ]
}
